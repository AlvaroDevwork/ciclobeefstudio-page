{
  "name": "ciclobeefstudio-page",
  "version": "1.0.0",
  "description": "**CicloBeef Studio** is an international project dedicated to the creation and distribution of high-end artistic prints inspired by history, politics, and society. This repository hosts the technical documentation site for the studio, built using **MkDocs + Material** and deployed to **GitHub Pages** under a fully-automated **GitFlow + CI/CD** workflow.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "vendor:sync": "node scripts/sync-vendor-assets.mjs",
    "assets:build": "node scripts/build-col001-assets.mjs",
    "build:frontend-assets": "npm run vendor:sync && npm run assets:build",
    "audit:product-options": "node scripts/audit-product-options.mjs",
    "qa:product-options": "node scripts/qa-product-options.mjs",
    "qa:variant-composer": "node scripts/qa-variant-composer.mjs",
    "qa:variant-composer-live": "node scripts/qa-variant-composer-live.mjs",
    "qa:variant-composer-static": "node scripts/qa-variant-composer-static.mjs",
    "qa:cart-regression": "node scripts/qa-cart-ui.mjs && node scripts/qa-cart-regression.mjs",
    "qa:e2e": "playwright test",
    "qa:e2e:cart": "playwright test tests/e2e/cart-runtime.spec.js",
    "qa:e2e:headed": "playwright test --headed"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlvaroHuenuqueoArias/ciclobeefstudio-page.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AlvaroHuenuqueoArias/ciclobeefstudio-page/issues"
  },
  "homepage": "https://github.com/AlvaroHuenuqueoArias/ciclobeefstudio-page#readme",
  "dependencies": {
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "sharp": "^0.35.3"
  }
}
